# Copia este archivo a `.env` EN EL VPS y rellena los valores.
#   cp .env.prod.example .env && nano .env && chmod 600 .env
# `.env` está en .gitignore: nunca lo subas al repositorio.
#
# Lo consume docker-compose.prod.yml. Docker Compose lee automáticamente el
# archivo `.env` de la carpeta desde la que ejecutas el comando.

# ── Dominios ────────────────────────────────────────────────────────────────
# Ambos deben tener un registro A apuntando a la IP del VPS ANTES de levantar,
# o Let's Encrypt no podrá emitir los certificados.
FRONTEND_DOMAIN=app.tudominio.com
BACKEND_DOMAIN=api.tudominio.com

# Correo para avisos de expiración de certificados de Let's Encrypt.
ACME_EMAIL=tu-correo@tudominio.com

# ── Base de datos (Postgres dentro del compose) ─────────────────────────────
DB_USERNAME=internetperla
# Genera una: openssl rand -base64 32
DB_PASSWORD=CAMBIAME_password_largo_y_aleatorio
DB_DATABASE=internetperla

# En producción el esquema NO se sincroniza solo: lo gobiernan las migraciones.
DB_SYNC=false
DB_MIGRATIONS_RUN=true

# ── Aplicación ──────────────────────────────────────────────────────────────
# Genera uno nuevo: openssl rand -hex 32
# NO reutilices el que estuvo commiteado en apps/backend/.env.local.
JWT_SECRET=CAMBIAME_secreto_de_32_bytes_en_hex
JWT_EXPIRES_IN=7d

BUSINESS_TZ=America/Guatemala

# Cierre automático de caja a las 20:00 hora del negocio.
AUTO_CLOSE_ENABLED=false

# ── Mapbox ──────────────────────────────────────────────────────────────────
# Token público (pk.*) del mapa de colaboradores. Se hornea en el bundle del
# frontend, así que es visible para cualquiera: restringe su uso por dominio
# (URL restrictions) desde el panel de Mapbox.
# Si lo dejas vacío, la app funciona pero la página del mapa se ve en blanco.
VITE_MAPBOX_TOKEN=
