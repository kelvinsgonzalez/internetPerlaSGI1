PORT=3000
NODE_ENV=development

DB_HOST=db
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=internetperla
DB_SYNC=true

# Obligatorio y SIN valor por defecto. Genera el tuyo, también en desarrollo:
#   openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=7d
BUSINESS_TZ=America/Guatemala
AUTO_CLOSE_ENABLED=true

# ── Administrador ───────────────────────────────────────────────────────────
# Ninguna credencial ni correo real se versiona: todo vive en tu `.env` local.
# Correo del administrador principal que crea `npm run seed`.
ADMIN_EMAIL=
ADMIN_NAME=Administrador
# Contraseña inicial. Si la dejas vacía, el seed genera una y la imprime UNA vez.
# Debe cumplir: 8+ caracteres con mayúscula, minúscula, número y símbolo.
SEED_ADMIN_PASSWORD=
# Cuenta de administrador anterior, a migrar y retirar (vacío si no existe).
LEGACY_ADMIN_EMAIL=
# Otras cuentas dadas de baja permanentemente, separadas por comas.
RETIRED_EMAILS=

# Colaborador de prueba: sólo fuera de producción y con contraseña aleatoria.
SEED_DEMO_USER=false
SEED_DEMO_USER_EMAIL=

# For cloud deployments (Neon, Render, etc.) - SOLO EJEMPLO
# NO uses credenciales reales aquí, esto se sube a GitHub.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB_NAME?sslmode=require
